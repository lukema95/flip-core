# Copy to .env and fill in the values you need. Never commit .env.

# --- Hardhat deployment scripts (scripts/deploy*.ts) ---
# Private key of the deployer account.
WALLET_PRIVATE_KEY=

# --- Foundry deployment script (script/Deploy.s.sol) ---
# forge reads these through vm.envUint / --rpc-url.
PRIVATE_KEY=
RPC_URL=

# --- Optional per-network RPC overrides ---
# Every network in hardhat.config.ts has a public fallback, so these are only
# needed when the fallback is rate limited or unavailable.
BSC_TESTNET_RPC_URL=
BASE_SEPOLIA_RPC_URL=
MEGAETH_TESTNET_RPC_URL=
PHAROS_TESTNET_RPC_URL=
PHAROS_DEVNET_RPC_URL=
OPTIMISM_SEPOLIA_RPC_URL=
MONAD_TESTNET_RPC_URL=
ETHEREUM_SEPOLIA_RPC_URL=
SCROLL_SEPOLIA_RPC_URL=
MANTLE_SEPOLIA_RPC_URL=

# --- Contract verification (see scripts/README-deployment.md) ---
ETHERSCAN_API_KEY=

# --- Example scripts (scripts/examples) ---
FACTORY_ADDRESS=
FLIP_ADDRESS=
TRADE_ADDRESS=
